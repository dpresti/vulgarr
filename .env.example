# Copy this file to .env and fill in the values for your setup.
# See the "Wiring into an existing stack" section of README.md for details
# on each of these.

# Host user/group that should own files this container creates. Run `id -u`
# and `id -g` on the host to find yours; defaults to 1000/1000 if unset.
PUID=1000
PGID=1000

TZ=America/New_York

# Host port to publish the UI on.
SPF_PORT=8011

# Where the SQLite DB and backups live on the host.
SPF_DATA_DIR=./data

# Container-side path your media is mounted at -- must exactly match the
# container-side path your Sonarr/Radarr containers already use.
SPF_MEDIA_ROOT=/media
MEDIA_ROOT_HOST_PATH=/path/to/your/media

# Optional: only needed if your library is split across a second mount that
# Sonarr/Radarr/Bazarr also mount independently. Delete the corresponding
# volume line in docker-compose.yml if you only have one media root.
SECOND_MEDIA_ROOT_HOST_PATH=
SECOND_MEDIA_ROOT_CONTAINER_PATH=

# From Settings > General > Security in each app. Only used to seed the
# database on first run -- editable afterward from Settings > Integrations.
SONARR_API_KEY=
RADARR_API_KEY=
BAZARR_API_KEY=

# Random string used to authenticate incoming webhooks. Leave unset and one
# is generated automatically on first run.
SPF_WEBHOOK_TOKEN=
